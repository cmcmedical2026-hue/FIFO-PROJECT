# Copy to .env and fill in. .env is gitignored and is never read by anything
# except flow.credentials. Leaving this unset makes the toolkit fall back to
# reading the login out of a HAR capture, which stores it in clear text.
FLOW_ACC=your_account
FLOW_USRID=your_user_id
FLOW_PASS=your_password

# Optional overrides
# FLOW_CONO=1
# FLOW_STRNO=1
# FLOW_HAR_ARCHIVE=E:\FLOW claude\har\Flow HAR files-20260915T171937Z-1-001.zip
# FLOW_ALLOW_HAR_CREDENTIALS=0   # refuse the HAR fallback entirely
